{
  "prerender": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/admin*" } },
          { "not": { "href_matches": "/api/*" } },
          { "not": { "href_matches": "/img/*" } },
          { "not": { "selector_matches": "[download], [target=_blank]" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
